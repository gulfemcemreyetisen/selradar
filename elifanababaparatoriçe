        const dynamicRadius = isDanger ? Math.round(sub.hazardRadiusM * (1 + overtoppingM * 0.18)) : sub.hazardRadiusM;

        const borderClass = isDanger
          ? 'border-rose-500/70 bg-rose-950/20'
