<!DOCTYPE html>
<html lang="tr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SelRadar & Akım Yok — Chókwè 2026 Taşkın Hafızası, Yol Güvenliği ve Elektrik Tehlike Erken Uyarı Sistemi</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: dark;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #060b14;
      color: #e2e8f0;
      overflow-x: hidden;
    }
    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace;
    }
    #chokweMap {
      height: 540px;
      width: 100%;
      background: #091326;
      border-radius: 0.75rem;
      z-index: 10;
    }
    @media (max-width: 1024px) {
      #chokweMap {
        height: 430px;
      }
    }
    .leaflet-popup-content-wrapper, .leaflet-popup-tip {
      background: #0f172a !important;
      color: #f1f5f9 !important;
      border: 1px solid #334155;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.7);
    }
    .leaflet-control-attribution {
      background: rgba(15, 23, 42, 0.85) !important;
      color: #94a3b8 !important;
      font-size: 10px !important;
    }
    .leaflet-control-attribution a {
      color: #38bdf8 !important;
    }
    /* Animated Flow Dashed Line */
    @keyframes dashFlow {
      to {
        stroke-dashoffset: -48;
      }
    }
    .flow-stream-line {
      stroke-dasharray: 10, 14;
      animation: dashFlow 1.3s linear infinite;
    }
    @keyframes hazardPulse {
      0%, 100% {
        stroke-opacity: 0.95;
        fill-opacity: 0.28;
      }
      50% {
        stroke-opacity: 0.4;
        fill-opacity: 0.12;
      }
    }
    .electro-hazard-zone {
      animation: hazardPulse 1.8s ease-in-out infinite;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #0f172a;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#060b14] text-slate-100 selection:bg-cyan-500 selection:text-slate-950">

  <!-- TOP COMMAND HEADER -->
  <header class="sticky top-0 z-40 border-b border-slate-800/90 bg-[#080f1e]/95 backdrop-blur-md">
    <div class="max-w-[1600px] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 via-blue-600 to-amber-500 p-0.5 shadow-lg shadow-cyan-500/20">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center font-mono-tech font-bold text-cyan-400 text-sm">
            SR⚡
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-base sm:text-lg font-extrabold tracking-tight text-white">
              SELRADAR <span class="text-amber-400">&amp; AKIM YOK</span>
            </h1>
            <span class="px-2 py-0.5 text-[11px] font-mono-tech font-semibold uppercase rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
              NASA Space Apps 2026 • Chókwè, Mozambik
            </span>
            <span id="liveAlertBadge" class="px-2 py-0.5 text-[11px] font-mono-tech font-bold uppercase rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 animate-pulse">
              EMSR857 AKTİF TAŞKIN • SEVİYE 4 ALARM
            </span>
          </div>
          <p class="text-xs text-slate-400">
            NISAR &amp; Sentinel-1 SAR Taşkın Haritalama • NASADEM S25/S26 Akış Rotaları • Tarihsel Sel Hafızası (2000–2026) • EDM Elektrik Tehlike &amp; Yol Kapama Komuta Sistemi
          </p>
        </div>
      </div>

      <!-- Quick Scenario & Emergency Controls -->
      <div class="flex items-center gap-2 flex-wrap">
        <div class="flex items-center bg-slate-900/90 border border-slate-700/80 rounded-lg p-1 text-xs">
          <button id="btnScenarioPre" type="button" class="px-2.5 py-1 rounded-md font-medium transition text-slate-300 hover:text-white">
            05 Oca (Önce)
          </button>
          <button id="btnScenarioOnset" type="button" class="px-2.5 py-1 rounded-md font-medium transition text-slate-300 hover:text-white">
            12 Oca (Taşkın Başlangıcı)
          </button>
          <button id="btnScenarioPeak" type="button" class="px-2.5 py-1 rounded-md font-medium transition bg-cyan-500 text-slate-950 font-bold">
            17 Oca (Zirve - 847.3 km²)
          </button>
          <button id="btnScenarioExtreme" type="button" class="px-2.5 py-1 rounded-md font-medium transition text-slate-300 hover:text-white">
            Süper Taşkın (+Baraj Deşarjı)
          </button>
        </div>

        <button id="btnEmergencyCutoffAll" type="button" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-md shadow-amber-500/20 transition">
          <span>⚡</span>
          <span id="btnEmergencyCutoffLabel">Kritik Trafoları Otomatik Kes (SCADA)</span>
        </button>

        <button id="btnBroadcastAll" type="button" class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs flex items-center gap-1.5 shadow-md shadow-rose-600/30 transition">
          <span>📡</span>
          <span>Acil Durum İhbarı Geç</span>
        </button>
      </div>
    </div>
  </header>

  <!-- KPI TELEMETRY RIBBON -->
  <section class="max-w-[1600px] w-full mx-auto px-4 pt-3 pb-2">
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-2.5">
      <!-- KPI 1 -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>Aktif Taşkın Yayılımı (SAR)</span>
          <span class="font-mono-tech text-cyan-400">Otsu + DEM</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiFloodArea" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-white">847.3 km²</span>
          <span id="kpiPolygonCount" class="text-xs font-mono-tech text-cyan-300">935 poligon</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Copernicus EMSR857 uyumu:</span>
          <span class="text-emerald-400 font-semibold">%91.4 IoU</span>
        </div>
      </div>

      <!-- KPI 2 -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>GPM Yağış &amp; GLDAS Toprak Nemi</span>
          <span class="font-mono-tech text-sky-400">NASA GIOVANNI</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiRainfall" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-sky-300">218 mm</span>
          <span id="kpiSoilMoisture" class="text-xs font-mono-tech text-amber-300">Nem: %94.2</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Macarretane Deşarj:</span>
          <span id="kpiDischarge" class="text-sky-300 font-mono-tech font-semibold">4,850 m³/s</span>
        </div>
      </div>

      <!-- KPI 3 -->
      <div class="bg-slate-900/80 border border-rose-900/50 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-rose-300">
          <span>Kapanan / Tehlikeli Yollar</span>
          <span class="font-mono-tech text-rose-400">ANE / OSM</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiClosedRoads" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-rose-400">5 / 8</span>
          <span class="text-xs text-rose-200">Koridor Kapalı</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Açık Tahliye Hattı:</span>
          <span class="text-emerald-400 font-semibold">EN101 → Chiaquelane</span>
        </div>
      </div>

      <!-- KPI 4 -->
      <div class="bg-slate-900/80 border border-amber-900/60 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-amber-300">
          <span>Elektrik Çarpma &amp; Yasaklı Bölge</span>
          <span class="font-mono-tech text-amber-400">EDM ŞEBEKE</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiHazardZones" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-amber-400">4 Bölge</span>
          <span id="kpiHazardRadius" class="text-xs font-mono-tech text-rose-300">11.4 km² yasaklı</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>SCADA Trafo Durumu:</span>
          <span id="kpiScadaStatus" class="text-rose-400 font-semibold">4 Aktif Kaçak Riski</span>
        </div>
      </div>

      <!-- KPI 5 -->
      <div class="bg-slate-900/80 border border-purple-900/50 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-purple-300">
          <span>Tarihsel Sel Hafıza Bankası</span>
          <span class="font-mono-tech text-purple-400">2000•2013•2026</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiMemoryMatch" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-purple-300">%88.6</span>
          <span class="text-xs text-purple-200">2013 İzi Örtüşmesi</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Kayıtlı Afet İzi:</span>
          <span id="kpiMemoryCount" class="text-purple-300 font-mono-tech font-semibold">4 Tarihsel Katman</span>
        </div>
      </div>

      <!-- KPI 6 -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3 flex flex-col justify-between">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>İlgili Birim İhbar &amp; Tahliye</span>
          <span class="font-mono-tech text-emerald-400">INGD / CENOE</span>
        </div>
        <div class="mt-1 flex items-baseline gap-2">
          <span id="kpiDispatchesSent" class="text-xl sm:text-2xl font-extrabold font-mono-tech text-emerald-400">6 İhbar</span>
          <span class="text-xs text-slate-300">330B Gaza Etkilenen</span>
        </div>
        <div class="mt-1 text-[11px] text-slate-400 flex items-center justify-between">
          <span>Kurtarma Filosu:</span>
          <span class="text-cyan-300 font-mono-tech">14 Bot • 4 Helikopter</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN WORKSPACE: LEFT/CENTER GIS & CONTROLS + RIGHT MODULE TABS -->
  <main class="max-w-[1600px] w-full mx-auto px-4 py-2 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-4">

    <!-- LEFT 7 COLUMNS: INTERACTIVE LEAFLET MAP + HYDROLOGICAL SIMULATION + LAYER CONTROLS -->
    <div class="lg:col-span-7 flex flex-col gap-3">
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 shadow-xl flex flex-col gap-3">

        <!-- Map Toolbar & Layer Toggles -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-2.5">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Harita Katmanları:</span>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-xs text-cyan-200 cursor-pointer">
              <input type="checkbox" id="toggleLayerFlood2026" checked class="accent-cyan-400 rounded" />
              <span>🌊 2026 Sel Yayılımı (SAR)</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-purple-500/10 border border-purple-500/30 text-xs text-purple-200 cursor-pointer">
              <input type="checkbox" id="toggleLayerMemory" checked class="accent-purple-400 rounded" />
              <span>🧠 Tarihsel Sel Hafızası (2000/2013)</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-sky-500/10 border border-sky-500/30 text-xs text-sky-200 cursor-pointer">
              <input type="checkbox" id="toggleLayerFlowVectors" checked class="accent-sky-400 rounded" />
              <span>🧭 Yağış Akış Rotaları (NASADEM D8)</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-rose-500/10 border border-rose-500/30 text-xs text-rose-200 cursor-pointer">
              <input type="checkbox" id="toggleLayerRoads" checked class="accent-rose-400 rounded" />
              <span>🚧 Kapanan Yollar &amp; Tahliye</span>
            </label>
            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/15 border border-amber-500/40 text-xs text-amber-200 cursor-pointer">
              <input type="checkbox" id="toggleLayerElectro" checked class="accent-amber-400 rounded" />
              <span>⚡ Trafo &amp; Yasaklı Elektrik Bölgeleri</span>
            </label>
          </div>

          <div class="flex items-center gap-1.5">
            <select id="selectBasemap" aria-label="Altlık Harita Seçimi" class="bg-slate-950 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-200">
              <option value="imagery">Esri Uydu Görüntüsü (World Imagery)</option>
              <option value="topo">Esri Topografik Harita (DEM/Eğim)</option>
              <option value="dark">Taktik Koyu Vektör Grid</option>
            </select>
            <button id="btnResetMapBounds" type="button" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 font-medium transition">
              Merkezle (Chókwè)
            </button>
          </div>
        </div>

        <!-- Map Container -->
        <div class="relative">
          <div id="chokweMap"></div>

          <!-- Floating Map Overlay Legend -->
          <div class="absolute bottom-3 left-3 z-[400] bg-slate-950/90 backdrop-blur-md border border-slate-700/80 rounded-xl p-2.5 text-[11px] max-w-xs shadow-lg pointer-events-auto">
            <div class="font-bold text-slate-200 mb-1.5 flex items-center justify-between">
              <span>CBS Semboloji &amp; Risk Anahtarı</span>
              <span class="font-mono-tech text-[10px] text-cyan-400">-24.53°, 32.98°</span>
            </div>
            <div class="grid grid-cols-1 gap-1 text-slate-300">
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-2.5 rounded-sm bg-cyan-500/60 border border-cyan-300 inline-block"></span>
                <span>2026 Aktif Sel Poligonu (Sentinel-1 / NISAR)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-2.5 rounded-sm bg-purple-500/35 border border-dashed border-purple-300 inline-block"></span>
                <span>Tarihsel Sel Hafızası (2000 &amp; 2013 İzi)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-0.5 bg-sky-300 border-b-2 border-dashed border-sky-400 inline-block"></span>
                <span>Yüzey Akış Yönü &amp; Taşkın Koridoru (D8)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-2.5 rounded-full bg-amber-500/40 border border-rose-500 inline-block"></span>
                <span>Elektrik Çarpma Tehlikesi / Yasaklı Bölge</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-1 bg-rose-500 inline-block"></span>
                <span>Kapanan / Giriş-Çıkışa Yasak Yol (ANE)</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-3.5 h-1 bg-emerald-400 inline-block"></span>
                <span>Güvenli Tahliye Koridoru (Lionde–Chiaquelane)</span>
              </div>
            </div>
          </div>

          <!-- Floating Coordinates & Inspector Pill -->
          <div class="absolute top-3 right-3 z-[400] bg-slate-950/90 backdrop-blur-md border border-slate-700/80 rounded-xl px-3 py-2 text-xs shadow-lg pointer-events-auto">
            <div class="text-[10px] uppercase tracking-wider text-slate-400">Harita Nokta Denetçisi (Tıkla &amp; Analiz Et)</div>
            <div id="mapInspectorCoord" class="font-mono-tech text-cyan-300 font-semibold mt-0.5">Enlem: -24.5300° | Boylam: 32.9800°</div>
            <div id="mapInspectorStatus" class="text-[11px] text-amber-300 mt-0.5">4. Bairro Çukuru • Derinlik: 2.8m • Elektrik Riski: YÜKSEK</div>
          </div>
        </div>

        <!-- Hydrological Parameter & Flood Memory Controls -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1">
          <!-- Control 1: Limpopo Water Level / Rainfall Slider -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-slate-200">GPM Yağış &amp; Limpopo Su Kotu</span>
              <span id="labelWaterLevel" class="font-mono-tech font-bold text-cyan-400">+3.4 m (17 Oca Zirve)</span>
            </div>
            <input id="sliderWaterLevel" type="range" min="0.5" max="5.2" step="0.1" value="3.4" class="w-full mt-2 accent-cyan-400 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono-tech mt-1">
              <span>0.5m (Normal)</span>
              <span>2.2m (Eşik)</span>
              <span>3.4m (2026)</span>
              <span>5.2m (2000 Rekor)</span>
            </div>
          </div>

          <!-- Control 2: NASADEM Slope Threshold & Soil Moisture -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-slate-200">NASADEM Eğim Filtresi &amp; Akış Hızı</span>
              <span id="labelSlopeFilter" class="font-mono-tech font-bold text-sky-400">Eğim &lt; 5.0° | 2.8 m/s</span>
            </div>
            <input id="sliderSlopeFilter" type="range" min="1.5" max="9.0" step="0.5" value="5.0" class="w-full mt-2 accent-sky-400 cursor-pointer" />
            <div class="flex justify-between text-[10px] text-slate-400 font-mono-tech mt-1">
              <span>1.5° (Sadece Çukur)</span>
              <span>5.0° (Standart SAR)</span>
              <span>9.0° (Yamaç Akışı)</span>
            </div>
          </div>

          <!-- Control 3: Historical Memory Snapshot Save & Compare -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-purple-200">Hafıza Bankası Karşılaştırma</span>
              <span id="badgeSavedMemoryCount" class="font-mono-tech text-[11px] text-purple-400">4 Kayıt Aktif</span>
            </div>
            <div class="flex items-center gap-1.5 mt-2">
              <select id="selectHistoricalOverlay" aria-label="Tarihsel Sel Hafızası Seçimi" class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-slate-200">
                <option value="all">Tüm Tarihsel Hafıza (2000 + 2013 + HEC-RAS)</option>
                <option value="2000">Şubat 2000 Siklon Eline (1,120 km² Rekor)</option>
                <option value="2013">Ocak 2013 Limpopo Taşkını (790 km²)</option>
                <option value="hecras">HEC-RAS Kronik Mahalle Duyarlılığı (Bairro 1-6)</option>
              </select>
              <button id="btnRecordCurrentToMemory" type="button" class="px-2.5 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs whitespace-nowrap transition">
                + Hafızaya Kaydet
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- BOTTOM CHART & SATELLITE PIPELINE PANEL -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Chart 1: Hydrological & Rainfall Time Series -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3.5">
          <div class="flex items-center justify-between mb-2">
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wider text-cyan-300">
                NASA GPM Yağış, GLDAS Toprak Nemi ve Taşkın Yayılım Grafiği
              </h2>
              <p class="text-[11px] text-slate-400">05 Ocak – 24 Ocak 2026 Chókwè / Limpopo Havzası Telemetrisi</p>
            </div>
            <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-slate-800 text-slate-300">GPM + Sentinel-1</span>
          </div>
          <div class="relative h-56">
            <canvas id="hydroChart"></canvas>
          </div>
        </div>

        <!-- Chart 2: Neighborhood Flood Memory & Electrical Risk Comparison -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3.5">
          <div class="flex items-center justify-between mb-2">
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wider text-amber-300">
                Mahalle (Bairro) Bazlı Sel Hafızası &amp; Elektrik Tehlike İndeksi
              </h2>
